{
  "name": "farm-optimizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Farm Crop-Mix Optimizer — Cloudflare Worker (static app + API) with a client-side Pyodide MILP solver.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node tests/units_selftest.cjs && node tests/import_roundtrip.cjs && node tests/canon_invariant.cjs && node tests/canon_flows.cjs && node tests/demo_derivation.cjs",
    "test:blob": "python3 scripts/sync_solver_blob.py --check",
    "db:auth-schema": "npx @better-auth/cli@latest generate --config ./auth.config.ts --output ./worker/db/schema/auth.ts --yes",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.6.19",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260616.1",
    "@types/node": "^25.9.3",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.100.0",
    "ws": "^8.21.0"
  }
}
